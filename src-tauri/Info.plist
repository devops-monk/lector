<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Lector has a real window, so it is an ordinary app with a Dock icon, and
       also keeps a menu bar item. Marking it LSUIElement would make it a pure
       accessory, and an accessory cannot bring its own windows to the front. -->

  <!-- The second entry point. Right-click selected text in any Cocoa app and
       macOS hands the text straight to us, with no Accessibility permission and
       no clipboard round-trip. Same destination as the hotkey. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Speak with Lector</string>
      </dict>
      <key>NSMessage</key>
      <string>speakSelection</string>
      <key>NSPortName</key>
      <string>Lector</string>
      <key>NSSendTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
    </dict>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Stop Lector</string>
      </dict>
      <key>NSMessage</key>
      <string>stopSpeaking</string>
      <key>NSPortName</key>
      <string>Lector</string>
      <key>NSSendTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
